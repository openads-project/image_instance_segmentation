Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: perception_msgs/ImageObservations
      Enabled: true
      Name: Road users
      Topic:
        Value: /demo/perception/road_users
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Image Source:
        Value: Image topic
        Image Topic: /demo/image
        Transport: compressed
        Synchronization: Synchronized
        Tolerance [ms]: 5
        Image Buffer: 60
      Mask:
        Value: true
        Mode: Filled + contour
        Alpha: 0.35
      Label:
        Value: true
        Format: "{id} {class} {class_prob}"
        Font Size: 14
    - Class: perception_msgs/ImageObservations
      Enabled: true
      Name: Traffic signs
      Topic:
        Value: /demo/perception/traffic_signs
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Image Source:
        Value: Crop mosaic
      Mask:
        Value: true
        Mode: Contour
      Color: Fixed
      Label:
        Value: true
        Format: "{id} sign {exist}"
    - Class: perception_msgs/ImageObservations
      Enabled: true
      Name: Traffic lights
      Topic:
        Value: /demo/perception/traffic_lights
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Image Source:
        Value: Crop mosaic
      Mask:
        Value: true
        Mode: Contour
      Color: By object ID
      Label:
        Value: true
        Format: "{id} light {exist}"
  Global Options:
    Fixed Frame: map
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
Window Geometry:
  Displays:
    collapsed: false
  Road users:
    collapsed: false
  Traffic signs:
    collapsed: false
  Traffic lights:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Width: 1600
  Height: 1000
